[Unit]
Description=MDM - Minimal Display Manager
After=systemd-user-sessions.service
After=plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service
# Never rate-limit restarts: a crash-looping DM must not leave the
# machine with no login screen (same as getty@.service)
StartLimitIntervalSec=0

[Service]
Type=idle
ExecStart=/usr/bin/mdm
Restart=always
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
